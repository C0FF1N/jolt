{
  "name": "jolt-mcp",
  "version": "1.0.0",
  "description": "Jolt MCP server: lets Claude Code, VS Code and other MCP clients drive one browser tab you choose, through the Jolt Chrome extension.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "browser-automation",
    "chrome-extension",
    "claude-code",
    "vscode",
    "ai-agent"
  ],
  "author": "C0FF1N",
  "license": "Apache-2.0",
  "homepage": "https://github.com/C0FF1N/jolt#readme",
  "bugs": "https://github.com/C0FF1N/jolt/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C0FF1N/jolt.git",
    "directory": "apps/server"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jolt-mcp": "dist/jolt-server.mjs"
  },
  "files": [
    "dist/jolt-server.mjs",
    "dist/THIRD_PARTY_NOTICES.txt",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm && shx chmod +x dist/*.js && node bundle.mjs",
    "prepublishOnly": "pnpm run build",
    "watch": "tsup src/index.ts --format esm --watch ",
    "inspector": "CLIENT_PORT=9001 SERVER_PORT=9002 pnpx @modelcontextprotocol/inspector node dist/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@r2r/messaging": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/messaging": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "@types/ws": "^8.18.0",
    "commander": "^13.1.0",
    "esbuild": "^0.25.0",
    "shx": "^0.3.4",
    "tsup": "^8.4.0",
    "typescript": "^5.6.2",
    "ws": "^8.18.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  }
}
